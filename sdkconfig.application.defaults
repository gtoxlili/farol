# Keep the OTA writer only in the retained factory Recovery image. The normal
# application exposes the enter-Recovery RPC through iris_ota_support_start().
# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Mosaico farol"
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000

# Runtime text is Chinese: a card holds 80+ distinct glyphs, and a page swipe
# redraws them every frame. Cache 512 rasterized glyphs (<= 40 px; about 800 KB
# of A8 pixels in PSRAM) instead of GSP's default 32.
CONFIG_ESP_GSP_FREETYPE_CACHE_GLYPHS=512
